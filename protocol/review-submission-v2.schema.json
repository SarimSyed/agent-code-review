{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SarimSyed/agent-code-review/schemas/review-submission-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "findings"],
  "properties": {
    "protocol_version": { "const": "2" },
    "session_id": { "type": "string", "minLength": 1 },
    "question_resolutions": { "type": "array" },
    "candidate_dispositions": { "type": "array" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "unit_id", "file", "start_line", "end_line", "severity", "category", "explanation", "evidence", "confidence"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "unit_id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "category": { "enum": ["bug", "security", "performance", "maintainability", "test", "style", "documentation", "other"] },
          "explanation": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "suggested_fix": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
