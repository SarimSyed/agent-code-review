{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SarimSyed/agent-code-review/schemas/review-workflow-v3.json",
  "type": "object",
  "required": ["protocol_version", "session_id", "state", "tasks"],
  "properties": { "protocol_version": { "const": "3" }, "session_id": { "type": "string" }, "state": { "enum": ["active", "ready", "complete"] }, "tasks": { "type": "array", "items": { "type": "object", "required": ["id", "unit_id", "phase", "state"], "properties": { "phase": { "enum": ["analysis", "critique", "resolve"] }, "state": { "enum": ["queued", "claimed", "submitted"] }, "submitted_at": { "type": "string", "format": "date-time" }, "claim_to_submit_ms": { "type": "integer", "minimum": 0 } } } }, "batch_calls": { "type": "integer", "minimum": 0 }, "validation_rejections": { "type": "integer", "minimum": 0 } }
}
