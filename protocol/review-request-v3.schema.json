{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SarimSyed/agent-code-review/schemas/review-request-v3.json",
  "type": "object",
  "required": ["protocol_version", "session_id", "created_at", "mode", "repository", "units", "instructions"],
  "properties": {
    "protocol_version": { "const": "3" },
    "session_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["diff", "scan"] },
    "repository": { "type": "object", "required": ["root"] },
    "units": { "type": "array", "minItems": 1 },
    "review_questions": { "type": "array" },
    "instructions": { "type": "object", "required": ["model_execution", "review_only", "do_not_modify_files", "review_profile"], "properties": { "model_execution": { "const": "host_agent" }, "review_only": { "const": true }, "do_not_modify_files": { "const": true }, "review_profile": { "const": "adaptive" } } }
  }
}
