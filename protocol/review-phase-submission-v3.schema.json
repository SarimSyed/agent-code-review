{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SarimSyed/agent-code-review/schemas/review-phase-submission-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "task_id", "unit_id", "phase", "executor", "communication", "payload"],
  "properties": {
    "protocol_version": { "const": "3" },
    "session_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["analysis", "critique", "resolve"] },
    "executor": { "$ref": "#/$defs/executor" },
    "communication": { "$ref": "#/$defs/communication" },
    "payload": {}
  },
  "allOf": [
    { "if": { "properties": { "phase": { "const": "analysis" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/analysis" } } } },
    { "if": { "properties": { "phase": { "const": "critique" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/critique" } } } },
    { "if": { "properties": { "phase": { "const": "resolve" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/resolve" } } } }
  ],
  "$defs": {
    "executor": { "type": "object", "additionalProperties": false, "required": ["host", "model", "context_id"], "properties": { "host": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "context_id": { "type": "string", "minLength": 1 } } },
    "communication": { "type": "object", "additionalProperties": false, "required": ["mode", "backend"], "properties": { "mode": { "enum": ["normal", "caveman"] }, "level": { "enum": ["lite", "full", "ultra"] }, "backend": { "enum": ["normal", "skill", "compact_fallback"] } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["file", "start_line", "end_line"], "properties": { "file": { "type": "string", "minLength": 1 }, "start_line": { "type": "integer", "minimum": 1 }, "end_line": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string" } } },
    "statement": { "type": "object", "additionalProperties": false, "required": ["id", "summary", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["id", "file", "start_line", "end_line", "title", "trigger", "impact", "severity", "category", "explanation", "evidence", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "file": { "type": "string", "minLength": 1 }, "start_line": { "type": "integer", "minimum": 1 }, "end_line": { "type": "integer", "minimum": 1 }, "title": { "type": "string", "minLength": 1 }, "trigger": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "severity": { "enum": ["critical", "high", "medium", "low"] }, "category": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1 }, "suggested_fix": { "type": "string" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "invariant_ids": { "type": "array", "items": { "type": "string" } }, "question_ids": { "type": "array", "items": { "type": "string" } } } },
    "analysis": { "type": "object", "additionalProperties": false, "required": ["coverage", "risk", "behavior_changes", "invariants", "traces", "candidates"], "properties": { "coverage": { "type": "string", "minLength": 1 }, "risk": { "type": "object", "additionalProperties": false, "required": ["level", "rationale"], "properties": { "level": { "enum": ["low", "high"] }, "rationale": { "type": "string", "minLength": 1 } } }, "behavior_changes": { "type": "array", "items": { "$ref": "#/$defs/statement" } }, "invariants": { "type": "array", "items": { "$ref": "#/$defs/statement" } }, "traces": { "type": "array" }, "questions": { "type": "array" }, "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } } } },
    "critique": { "type": "object", "additionalProperties": false, "required": ["critic_mode", "verdicts"], "properties": { "critic_mode": { "enum": ["independent", "same_context"] }, "verdicts": { "type": "array", "items": { "type": "object", "required": ["candidate_id", "verdict", "rationale", "confidence"], "properties": { "candidate_id": { "type": "string" }, "verdict": { "enum": ["supported", "unsupported", "revise"] }, "rationale": { "type": "string" }, "confidence": { "type": "number" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "replacement": { "$ref": "#/$defs/candidate" } } } }, "new_candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } } } },
    "resolve": { "type": "object", "additionalProperties": false, "required": ["coverage", "candidate_dispositions"], "properties": { "coverage": { "type": "string", "minLength": 1 }, "candidate_dispositions": { "type": "array", "items": { "type": "object", "required": ["candidate_id", "outcome", "reason"], "properties": { "candidate_id": { "type": "string" }, "outcome": { "enum": ["submit", "drop"] }, "reason": { "type": "string" }, "override_reason": { "type": "string" }, "additional_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } } } } } }
  }
}
