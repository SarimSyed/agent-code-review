{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SarimSyed/agent-code-review/schemas/review-request-v2.json",
  "type": "object",
  "required": ["protocol_version", "session_id", "created_at", "mode", "repository", "units", "instructions"],
  "properties": {
    "protocol_version": { "const": "2" },
    "session_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["diff", "scan"] },
    "repository": { "type": "object", "required": ["root"], "properties": { "root": { "type": "string" }, "revision": { "type": "string" } } },
    "background": { "type": "string" },
    "units": { "type": "array", "minItems": 1 },
    "review_questions": { "type": "array" },
    "instructions": {
      "type": "object",
      "required": ["model_execution", "review_only", "do_not_modify_files", "output_file", "review_profile", "token_economy"],
      "properties": {
        "model_execution": { "const": "host_agent" },
        "review_only": { "const": true },
        "do_not_modify_files": { "const": true },
        "output_file": { "type": "string" },
        "review_profile": { "enum": ["standard", "deep"] },
        "token_economy": { "$ref": "#/$defs/tokenEconomy" }
      }
    }
  },
  "$defs": {
    "tokenEconomy": {
      "oneOf": [
        { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "normal" } } },
        { "type": "object", "required": ["mode", "level"], "properties": { "mode": { "const": "caveman" }, "level": { "enum": ["lite", "full", "ultra"] } } }
      ]
    }
  }
}
